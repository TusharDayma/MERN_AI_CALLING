generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum ResetStatus {
  PENDING
  RESOLVED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum QuestionLevel {
  EASY
  MEDIUM
  HARD
}

enum CandidateStatus {
  PENDING
  WHATSAPP_SENT
  WHATSAPP_REPLIED
  MAGIC_LINK_SENT
  INTERVIEW_IN_PROGRESS
  VOICE_FALLBACK_DISPATCHED
  INTEREST_DECLINED
  SCREENED
  COMPLETED
  EXPIRED
  DATA_ERASED_DPDP
}

model User {
  id              String           @id @default(uuid())
  name            String
  username        String           @unique
  email           String           @unique
  password_hash   String
  role            Role             @default(HR)
  status          UserStatus       @default(ACTIVE)
  is_deleted          Boolean          @default(false)
  credits_balance     Int              @default(100)
  total_voice_minutes Float            @default(0)
  api_cost            Float            @default(0)
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt

  passwordResets  PasswordReset[]
  jobRoles        JobRole[]
  campaigns       Campaign[]
  
  @@map("users")
}

model PasswordReset {
  id          String      @id @default(uuid())
  user_id     String
  status      ResetStatus @default(PENDING)
  created_at  DateTime    @default(now())

  user        User        @relation(fields: [user_id], references: [id])
  
  @@map("password_resets")
}

model JobRole {
  id          String      @id @default(uuid())
  title       String
  department     String
  description    String
  scoring_rubric String? // JSON strictly structured as { technical: number, communication: number, culture: number }
  created_by     String

  user        User        @relation(fields: [created_by], references: [id])
  campaigns   Campaign[]
  
  @@map("job_roles")
}

model Campaign {
  id                String          @id @default(uuid())
  name              String
  location          String
  job_role_id       String
  created_by_hr_id  String
  status            CampaignStatus  @default(DRAFT)
  created_at        DateTime        @default(now())

  jobRole           JobRole         @relation(fields: [job_role_id], references: [id])
  hr                User            @relation(fields: [created_by_hr_id], references: [id])
  questions         Question[]
  candidates        Candidate[]
  
  @@map("campaigns")
}

model Question {
  id              String        @id @default(uuid())
  campaign_id     String?
  text            String
  type            String
  level           QuestionLevel
  key_criteria    String?
  expected_answer String?

  campaign    Campaign?     @relation(fields: [campaign_id], references: [id])
  
  @@map("questions")
}

model Candidate {
  id                  String          @id @default(uuid())
  campaign_id         String
  name                String
  email               String
  contact             String
  emp_details         String
  status              CandidateStatus @default(PENDING)
  ai_score            Int?
  dossier_json        String?
  whatsapp_status     String?
  whatsapp_sent_at   DateTime?
  whatsapp_replied_at DateTime?
  email_status        String?
  email_sent_at       DateTime?
  consent_status      String?
  magic_token         String?         @unique
  magic_token_expires_at DateTime?
  dpdp_consent_given  Boolean         @default(false)
  dpdp_consent_at     DateTime?
  dpdp_consent_channel String?
  erasure_requested_at DateTime?
  fallback_call_at    DateTime?
  call_attempts       Int             @default(0)
  last_attempt_at     DateTime?

  campaign            Campaign        @relation(fields: [campaign_id], references: [id])
  
  @@map("candidates")
}

model DpdpAuditLog {
  id              String        @id @default(uuid())
  candidate_id    String?
  candidate_phone String?
  action          String        // CONSENT_GRANTED | CONSENT_DECLINED | RIGHT_TO_ERASURE_PURGED | DATA_ACCESSED
  channel         String        // WHATSAPP | WEB_SCREENING | HR_PORTAL
  details         String?
  ip_address      String?
  timestamp       DateTime      @default(now())

  @@map("dpdp_audit_logs")
}
