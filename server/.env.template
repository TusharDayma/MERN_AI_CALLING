# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# MySQL Connection String Format:
# DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"
DATABASE_URL="mysql://root:password@localhost:3306/antitalk_db"

# JWT Secret for Authentication
JWT_SECRET="super-secret-jwt-key-change-me-in-production"

# Twilio Account SID and Auth Token (for HR campaigns)
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# Application Port
PORT=5000

# Telephony Public Webhooks & Streams
BOT_WEBSOCKET_URL="wss://your-ngrok-or-domain.com/media-stream"
STATUS_CALLBACK_URL="https://your-ngrok-or-domain.com/api/telephony/leg/webhook"
